{
  "actions": [
    {
      "choose": [
        {
          "conditions": [
            {
              "condition": "template",
              "value_template": "{{ trigger.id=='play_favorite' }}"
            }
          ],
          "sequence": [
            {
              "action": "script.play_radio",
              "data": {
                "station": "{{ trigger.sentence }}"
              },
              "response_variable": "r"
            },
            {
              "set_conversation_response": "{{ r.chat_text if (r is defined and r.chat_text is defined) else 'Playing.' }}"
            }
          ]
        },
        {
          "conditions": [
            {
              "condition": "template",
              "value_template": "{{ trigger.id=='play_radio' }}"
            }
          ],
          "sequence": [
            {
              "set_conversation_response": "Playing radio on the ceiling speakers."
            },
            {
              "action": "script.play_radio"
            }
          ]
        },
        {
          "conditions": [
            {
              "condition": "template",
              "value_template": "{{ trigger.id=='pause' }}"
            }
          ],
          "sequence": [
            {
              "action": "rest_command.resolver_command",
              "continue_on_error": true,
              "data": {
                "intent": "interaction",
                "params": {
                  "mode": "pause"
                }
              }
            },
            {
              "set_conversation_response": "Paused."
            }
          ]
        },
        {
          "conditions": [
            {
              "condition": "template",
              "value_template": "{{ trigger.id=='resume' }}"
            }
          ],
          "sequence": [
            {
              "set_conversation_response": "Resuming."
            },
            {
              "action": "rest_command.resolver_command",
              "continue_on_error": true,
              "data": {
                "intent": "interaction",
                "params": {
                  "mode": "resume"
                }
              }
            }
          ]
        },
        {
          "conditions": [
            {
              "condition": "template",
              "value_template": "{{ trigger.id=='stop' }}"
            }
          ],
          "sequence": [
            {
              "action": "rest_command.resolver_command",
              "continue_on_error": true,
              "data": {
                "intent": "interaction",
                "params": {
                  "mode": "pause"
                }
              }
            },
            {
              "set_conversation_response": "Stopped."
            }
          ]
        },
        {
          "conditions": [
            {
              "condition": "template",
              "value_template": "{{ trigger.id=='vol_set' }}"
            }
          ],
          "sequence": [
            {
              "variables": {
                "dir": "{% set raw = trigger.slots.percent | default('') | string | lower %}{% if 'down' in raw %}down{% elif 'up' in raw %}up{% else %}set{% endif %}",
                "num": "{% set raw = trigger.slots.percent | default('') | string | lower %}{% set d = raw | regex_findall('[0-9]+') %}{% if d %}{{ d[0]|int }}{% else %}{% set r = raw|replace('percent','')|replace('up','')|replace('down','')|replace('to','')|replace('-',' ')|trim %}{% set o={'zero':0,'one':1,'two':2,'three':3,'four':4,'five':5,'six':6,'seven':7,'eight':8,'nine':9,'ten':10,'eleven':11,'twelve':12,'thirteen':13,'fourteen':14,'fifteen':15,'sixteen':16,'seventeen':17,'eighteen':18,'nineteen':19,'twenty':20,'thirty':30,'forty':40,'fifty':50,'sixty':60,'seventy':70,'eighty':80,'ninety':90,'hundred':100} %}{% set ns=namespace(v=0,fl=false) %}{% for w in r.split() %}{% if w in o %}{% set ns.v=ns.v+o[w] %}{% set ns.fl=true %}{% endif %}{% endfor %}{{ ns.v if ns.fl else 0 }}{% endif %}"
              }
            },
            {
              "set_conversation_response": "{% if dir=='down' %}Turning it down.{% elif dir=='up' %}Turning it up.{% else %}Setting the volume.{% endif %}"
            },
            {
              "action": "rest_command.resolver_command",
              "continue_on_error": true,
              "data": {
                "intent": "interaction",
                "params": {
                  "mode": "{% if dir=='up' %}volume_up{% elif dir=='down' %}volume_down{% else %}set_volume{% endif %}",
                  "step": "{{ num | int(10) }}",
                  "volume": "{{ num | int(0) }}"
                }
              }
            }
          ]
        },
        {
          "conditions": [
            {
              "condition": "template",
              "value_template": "{{ trigger.id=='vol_up' }}"
            }
          ],
          "sequence": [
            {
              "variables": {
                "step": "{% set raw = trigger.slots.percent | default('') | string | lower %}{% set r = raw | replace('percent','') | replace('%','') | replace('by','') | trim %}{% if r.isdigit() %}{{ r|int }}{% else %}{% set o={'zero':0,'one':1,'two':2,'three':3,'four':4,'five':5,'six':6,'seven':7,'eight':8,'nine':9,'ten':10,'eleven':11,'twelve':12,'thirteen':13,'fourteen':14,'fifteen':15,'sixteen':16,'seventeen':17,'eighteen':18,'nineteen':19,'twenty':20,'thirty':30,'forty':40,'fifty':50,'sixty':60,'seventy':70,'eighty':80,'ninety':90,'hundred':100} %}{% set ns=namespace(v=0,f=false) %}{% for w in r.split() %}{% if w in o %}{% set ns.v=ns.v+o[w] %}{% set ns.f=true %}{% endif %}{% endfor %}{{ ns.v if ns.f else 10 }}{% endif %}"
              }
            },
            {
              "set_conversation_response": "Turning it up."
            },
            {
              "action": "rest_command.resolver_command",
              "continue_on_error": true,
              "data": {
                "intent": "interaction",
                "params": {
                  "mode": "volume_up",
                  "step": "{{ step | int(10) }}"
                }
              }
            }
          ]
        },
        {
          "conditions": [
            {
              "condition": "template",
              "value_template": "{{ trigger.id=='vol_down' }}"
            }
          ],
          "sequence": [
            {
              "variables": {
                "step": "{% set raw = trigger.slots.percent | default('') | string | lower %}{% set r = raw | replace('percent','') | replace('%','') | replace('by','') | trim %}{% if r.isdigit() %}{{ r|int }}{% else %}{% set o={'zero':0,'one':1,'two':2,'three':3,'four':4,'five':5,'six':6,'seven':7,'eight':8,'nine':9,'ten':10,'eleven':11,'twelve':12,'thirteen':13,'fourteen':14,'fifteen':15,'sixteen':16,'seventeen':17,'eighteen':18,'nineteen':19,'twenty':20,'thirty':30,'forty':40,'fifty':50,'sixty':60,'seventy':70,'eighty':80,'ninety':90,'hundred':100} %}{% set ns=namespace(v=0,f=false) %}{% for w in r.split() %}{% if w in o %}{% set ns.v=ns.v+o[w] %}{% set ns.f=true %}{% endif %}{% endfor %}{{ ns.v if ns.f else 10 }}{% endif %}"
              }
            },
            {
              "set_conversation_response": "Turning it down."
            },
            {
              "action": "rest_command.resolver_command",
              "continue_on_error": true,
              "data": {
                "intent": "interaction",
                "params": {
                  "mode": "volume_down",
                  "step": "{{ step | int(10) }}"
                }
              }
            }
          ]
        }
      ]
    }
  ],
  "alias": "Voice — Ceiling Speakers",
