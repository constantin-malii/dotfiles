{
  "alias": "Ceiling: News Headlines (resolver)",
  "mode": "single",
  "object_id": "news",
  "sequence": [
    {
      "action": "rest_command.resolver_command",
      "continue_on_error": true,
      "data": {
        "intent": "news",
        "params": {}
      },
      "response_variable": "r"
    },
    {
      "variables": {
        "resp": {
          "chat_text": "{{ r.content.chat_text if (r is defined and r.content is defined and r.content.chat_text is defined) else 'Sorry, I could not get the news right now.' }}"
        }
      }
    },
    {
      "response_variable": "resp",
      "stop": "done"
    }
  ]
}
