{
  "alias": "Ceiling: Find Radio Stations (resolver)",
  "description": "Find and speak the top radio stations matching a genre or country (does not start playback). Use for 'find jazz stations', 'what news stations are there'.",
  "fields": {
    "country": {
      "description": "Country/nationality (optional).",
      "name": "Country",
      "required": false,
      "selector": {
        "text": {}
      }
    },
    "genre": {
      "description": "Genre to search, e.g. jazz (optional).",
      "name": "Genre",
      "required": false,
      "selector": {
        "text": {}
      }
    }
  },
  "icon": "mdi:radio-tower",
  "object_id": "find_stations",
  "sequence": [
    {
      "action": "rest_command.resolver_command",
      "continue_on_error": true,
      "data": {
        "intent": "radio",
        "params": {
          "country": "{{ country | default('', true) }}",
          "genre": "{{ genre | default('', true) }}",
          "mode": "find"
        }
      },
      "response_variable": "r"
    },
    {
      "variables": {
        "resp": {
          "chat_text": "{{ r.content.chat_text if (r is defined and r.content is defined and r.content.chat_text is defined) else 'Sorry, I could not reach the radio system.' }}"
        }
      }
    },
    {
      "response_variable": "resp",
      "stop": "done"
    }
  ]
}
